# Server port
PORT=9000

# Neon PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Allowed client origin for CORS (required in production)
CLIENT_URL=https://your-client.vercel.app

# Bearer token to protect /metrics endpoint (required — auto-generated on Render)
METRICS_TOKEN=your-secret-metrics-token
